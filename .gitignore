# ==============================================================================
# .gitignore — Estação Meteorológica com ESP32
# ==============================================================================

# Arquivos compactados e pacotes de entrega
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.bak
*.orig

# Ambientes virtuais e caches Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv314/
venv/
ENV/
build/
dist/

# Variáveis de ambiente e segredos locais
.env
.env.*
!.env.example
*.local

# Dependências JavaScript / Web / Firebase
node_modules/
.firebase/
.npm/

# Sistema operacional e configurações de IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Configuracao privada da placa
firmware/config.py
.esp32-backup/
.estacao-local/

# Backups privados e arquivos auxiliares de edição
firmware/config.py.*
webrepl_cfg.py
tmp/
outputs/
Video final/
*.dqy
*.odc
*.xlsx
*.xls
~$*

# Gravações integrais e relatório com vídeos incorporados ficam fora do Git
evidencias/**/*.mp4
evidencias/**/*.m4a
evidencias/**/*.ogg
output/documentacao/V5-atualizada/Documentacao_Estacao_Meteorologica_V5_atualizada.pdf

# Arquivos de trabalho preservados localmente, fora da entrega publicada
/output/
/evidencias/
/docs/*.pdf
/docs/*.md
!/docs/README.md
/docs/img/
/docs/images/
/docs/evidencias/2026-11-07/
/teste_ct03.py
/firmware/diagnostico_mq135.py
