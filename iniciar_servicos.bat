@echo off
setlocal DisableDelayedExpansion
powershell.exe -NoLogo -NoProfile -Command "& { $iniciar = { $ErrorActionPreference = 'Stop'; $Host.UI.RawUI.WindowTitle = 'Estacao - MySQL e Mosquitto'; foreach ($item in @(@('MySQL', 'MySQL*'), @('Mosquitto', 'mosquitto*'))) { try { $services = @(Get-Service -Name $item[1] -ErrorAction SilentlyContinue); if ($services.Count -eq 0) { throw ($item[0] + ' nao encontrado como servico do Windows. Confira a instalacao.'); }; if ($services.Count -gt 1) { throw ('Mais de um servico ' + $item[0] + ' encontrado: ' + (($services | Select-Object -ExpandProperty Name) -join ', ') + '. Selecione o correto pelo aplicativo Servicos do Windows.'); }; $service = $services[0]; Set-Service -Name $service.Name -StartupType Automatic; if ($service.Status -ne 'Running') { Write-Host ('Iniciando ' + $service.Name + '...'); Start-Service -Name $service.Name; $service.WaitForStatus('Running', [TimeSpan]::FromSeconds(30)); $service.Refresh(); }; Write-Host ($service.Name + ': Running. Inicializacao automatica configurada.') -ForegroundColor Green; } catch { Write-Host ('ERRO: ' + $_.Exception.Message) -ForegroundColor Red; } }; Write-Host 'Pode fechar esta janela. Os servicos continuam funcionando.' -ForegroundColor Cyan; }; try { $identity = [Security.Principal.WindowsIdentity]::GetCurrent(); $principal = New-Object Security.Principal.WindowsPrincipal($identity); if ($principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { & $iniciar; } else { Write-Host 'Autorize a solicitacao do Windows para gerenciar os servicos.' -ForegroundColor Cyan; $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($iniciar.ToString())); Start-Process -FilePath (Join-Path $PSHOME 'powershell.exe') -Verb RunAs -WindowStyle Normal -ArgumentList @('-NoLogo', '-NoProfile', '-NoExit', '-EncodedCommand', $encoded) -Wait; } } catch { Write-Host ('ERRO: nao foi possivel obter permissao de administrador. ' + $_.Exception.Message) -ForegroundColor Red; } }"
echo.
pause
endlocal
