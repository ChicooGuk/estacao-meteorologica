@echo off
setlocal DisableDelayedExpansion
set "ESTACAO_PROJECT_DIR=%~dp0"
powershell.exe -NoLogo -NoProfile -NoExit -Command "& { $ErrorActionPreference = 'Stop'; Set-Location -LiteralPath $env:ESTACAO_PROJECT_DIR; $Host.UI.RawUI.WindowTitle = 'Estacao - Backend'; try { $python = $null; foreach ($candidate in @('.venv314\Scripts\python.exe', '.venv\Scripts\python.exe')) { if (Test-Path -LiteralPath $candidate) { $python = (Resolve-Path -LiteralPath $candidate).Path; break; } }; if (-not $python) { throw 'Ambiente Python ausente. Crie .venv314 e instale backend\requirements.txt.'; }; if (-not (Test-Path -LiteralPath 'backend\.env')) { throw 'Falta backend\.env. Copie backend\.env.example e preencha as configuracoes.'; }; if (Get-NetTCPConnection -State Listen -LocalPort 8000 -ErrorAction SilentlyContinue) { throw 'A porta 8000 ja esta em uso. Verifique a janela do backend antes de iniciar outra instancia.'; }; foreach ($service in @(Get-Service -Name 'MySQL*','mosquitto*' -ErrorAction SilentlyContinue)) { if ($service.Status -ne 'Running') { Write-Warning ('Servico parado: ' + $service.Name + '. Execute iniciar_servicos.bat antes do backend.'); } }; & $python -c 'import uvicorn; import fastapi; import paho.mqtt.client; import mysql.connector'; if ($LASTEXITCODE -ne 0) { throw 'Dependencias ausentes. Instale backend\requirements.txt usando o Python deste ambiente.'; }; Write-Host 'Iniciando backend. Deixe esta janela aberta. Para encerrar: Ctrl+C.' -ForegroundColor Cyan; & $python -m uvicorn python:app --app-dir backend --env-file backend\.env --host 0.0.0.0 --port 8000 --log-level info; if ($LASTEXITCODE -ne 0) { throw 'O backend encerrou com erro. Confira a mensagem acima e os servicos MySQL/Mosquitto.'; } } catch { Write-Host ('ERRO: ' + $_.Exception.Message) -ForegroundColor Red; } }"
endlocal
