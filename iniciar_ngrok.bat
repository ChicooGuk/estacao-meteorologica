@echo off
setlocal DisableDelayedExpansion
set "ESTACAO_PROJECT_DIR=%~dp0"
powershell.exe -NoLogo -NoProfile -NoExit -Command "& { $ErrorActionPreference = 'Stop'; Set-Location -LiteralPath $env:ESTACAO_PROJECT_DIR; $Host.UI.RawUI.WindowTitle = 'Estacao - ngrok'; try { $command = Get-Command ngrok.exe -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1; $ngrok = if ($command) { $command.Source } else { $null }; if (-not $ngrok) { foreach ($candidate in @((Join-Path $env:LOCALAPPDATA 'Microsoft\WindowsApps\ngrok.exe'), (Join-Path $env:LOCALAPPDATA 'Microsoft\WinGet\Links\ngrok.exe'))) { if (Test-Path -LiteralPath $candidate) { $ngrok = $candidate; break; } } }; if (-not $ngrok) { throw 'ngrok nao encontrado. Instale-o e confirme ngrok version em um novo terminal.'; }; if (-not (Get-NetTCPConnection -State Listen -LocalPort 8000 -ErrorAction SilentlyContinue)) { throw 'Backend nao esta escutando na porta 8000. Execute iniciar_backend.bat e aguarde Application startup complete.'; }; Write-Host 'Iniciando tunel fixo. Deixe esta janela aberta. Para encerrar: Ctrl+C.' -ForegroundColor Cyan; & $ngrok http 'http://127.0.0.1:8000' '--url=https://hangup-oblivion-second.ngrok-free.dev'; if ($LASTEXITCODE -ne 0) { throw 'ngrok encerrou com erro. Confira acima a autenticacao ou se este dominio ja esta em uso em outra janela.'; } } catch { Write-Host ('ERRO: ' + $_.Exception.Message) -ForegroundColor Red; } }"
endlocal
