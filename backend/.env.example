# Defina estas variaveis no ambiente antes de iniciar uvicorn python:app.
# Este arquivo e um modelo; a aplicacao nao carrega .env automaticamente.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=estacao_meteorologica
DB_USER=estacao
DB_PASSWORD=PREENCHER
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_CLIENT_ID=estacao-backend
CORS_ORIGINS=http://localhost:5500
# Opcional. Vazio desabilita POST HTTP; MQTT continua funcionando.
HTTP_INGEST_TOKEN=

# Chave privada para salvar a localizacao pelo mapa. Vazio desabilita o ajuste.
LOCATION_ADMIN_TOKEN=
